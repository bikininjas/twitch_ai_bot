    def get_random_personality(self, exclude_current: bool = True) -> Personality:
        """
        Sélectionne une personnalité aléatoire
        
        Args:
            exclude_current: Exclure la personnalité actuelle
            
        Returns:
            Personality: Nouvelle personnalité sélectionnée
        """
        available_types = list(self.personalities.keys())
        
        if exclude_current and self.current_personality:
            available_types = [t for t in available_types if t != self.current_personality.type]
        
        # Éviter de répéter une personnalité récente
        if len(self.personality_history) >= 3:
            recent = self.personality_history[-2:]  # Les 2 dernières
            available_types = [t for t in available_types if t not in recent]
        
        if not available_types:  # Fallback si toutes sont exclues
            available_types = list(self.personalities.keys())
        
        selected_type = random.choice(available_types)
        return self.personalities[selected_type]
    
    def change_personality(self, new_personality: Optional[Personality] = None, force: bool = False) -> Tuple[Personality, str]:
        """
        Change la personnalité du bot
        
        Args:
            new_personality: Personnalité spécifique ou None pour aléatoire
            force: Ignorer le cooldown
            
        Returns:
            Tuple[Personality, str]: Nouvelle personnalité et message d'annonce
        """
        import time
        
        # Vérifier le cooldown (sauf si forcé)
        if not force and self._is_on_cooldown():
            remaining = self.get_cooldown_remaining()
            logger.warning(f"Changement de personnalité en cooldown ({remaining}s restants)")
            raise ValueError(f"Changement en cooldown ({remaining}s restants)")
        
        if new_personality is None:
            new_personality = self.get_random_personality()
        
        # Archiver l'ancienne personnalité
        if self.current_personality:
            self.personality_history.append(self.current_personality.type)
            if len(self.personality_history) > 10:  # Garder seulement les 10 dernières
                self.personality_history.pop(0)
        
        self.current_personality = new_personality
        self.last_change_time = time.time()
        
        # Choisir une variante d'annonce aléatoire
        announcement = random.choice(new_personality.announcement_variants)
        
        logger.info(f"Changement de personnalité vers: {new_personality.name} ({new_personality.type.value})")
        
        return new_personality, announcement
    
    def get_current_personality(self) -> Optional[Personality]:
        """Retourne la personnalité actuelle"""
        return self.current_personality
    
    def get_personality_prompt(self) -> str:
        """Retourne le prompt de la personnalité actuelle"""
        if self.current_personality:
            return self.current_personality.prompt_base
        return self.personalities[PersonalityType.SARCASTIC].prompt_base  # Fallback
    
    def get_personality_signature(self) -> str:
        """Retourne la signature de la personnalité actuelle"""
        if self.current_personality:
            return self.current_personality.signature
        return "- nova 🐱"  # Fallback
    
    def get_random_catchphrase(self) -> str:
        """Retourne une phrase d'accroche aléatoire de la personnalité actuelle"""
        if self.current_personality and self.current_personality.catchphrases:
            return random.choice(self.current_personality.catchphrases)
        return "Alors..."  # Fallback
    
    def get_personality_stats(self) -> Dict:
        """Retourne les statistiques des personnalités"""
        return {
            "current": self.current_personality.name if self.current_personality else None,
            "available_count": len(self.personalities),
            "history": [p.value for p in self.personality_history[-5:]],  # 5 dernières
            "all_personalities": [p.name for p in self.personalities.values()],
            "cooldown": {
                "active": self._is_on_cooldown(),
                "remaining_seconds": self.get_cooldown_remaining()
            }
        }
    
    def _is_on_cooldown(self) -> bool:
        """
        Vérifie si le système est en cooldown
        
        Returns:
            bool: True si en cooldown
        """
        import time
        if self.last_change_time == 0:
            return False
        return time.time() - self.last_change_time < self.cooldown_time
    
    def get_cooldown_remaining(self) -> int:
        """
        Retourne le temps de cooldown restant en secondes
        
        Returns:
            int: Secondes restantes (0 si pas de cooldown)
        """
        import time
        if self.last_change_time == 0:
            return 0
        remaining = self.cooldown_time - (time.time() - self.last_change_time)
        return max(0, int(remaining))
    
    def set_cooldown_time(self, seconds: int):
        """
        Définit la durée du cooldown
        
        Args:
            seconds: Durée en secondes
        """
        self.cooldown_time = seconds
        logger.info(f"Cooldown défini à {seconds} secondes")